# Keep repository-only files out of the dist zips Packagist serves.
# A consuming application needs src/, composer.json, the README and the LICENSE
# — not the test suite or this file.
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/tests export-ignore
/phpunit.xml export-ignore
/.phpunit.cache export-ignore
/.phpunit.result.cache export-ignore
/composer.lock export-ignore
