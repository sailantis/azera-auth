{
    "name": "sailantis/azera-auth",
    "description": "Authentication companion for the Azera framework: guards (session, token, JWT, OAuth2), user providers, password reset, email verification, authorization, and two-factor authentication.",
    "type": "library",
    "repositories": [
        {
            "type": "path",
            "url": "../azera-framework"
        },
        {
            "type": "path",
            "url": "../clarity-engine"
        }
    ],
    "require": {
      "php": ">=8.2",
        "sailantis/azera-framework": "dev-main",
        "psr/log": "3.0",
        "psr/event-dispatcher": "1.0",
        "psr/simple-cache": "3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "firebase/php-jwt": "For the JwtGuard (HS256/RS256 token authentication).",
        "league/oauth2-client": "For the OAuth2Guard (Google, GitHub, generic providers).",
        "spomky-labs/otphp": "For TwoFactorAuthenticator (TOTP).",
        "bacon/bacon-qr-code": "For TwoFactorAuthenticator QR code rendering."
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Azera\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Azera\\Auth\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}